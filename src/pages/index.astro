---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">Categories</label>
            <select
              id="category-filter"
              name="category"
              multiple
              class="min-h-32 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="category-filter"
            >
              {categories.map((category) => <option value={category.id}>{category.name}</option>)}
            </select>
            <p class="mt-2 text-sm text-slate-400">Select one or more categories.</p>
          </div>
          <div>
            <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
            <select
              id="publisher-filter"
              name="publisher"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>
        </div>
        <div class="mt-4 flex items-center gap-4">
          <button
            type="button"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="clear-filters"
          >
            Clear filters
          </button>
          <p class="text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-status"></p>
        </div>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryFilter = document.querySelector<HTMLSelectElement>('#category-filter');
  const publisherFilter = document.querySelector<HTMLSelectElement>('#publisher-filter');
  const clearFilters = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
  const filterStatus = document.querySelector<HTMLElement>('[data-testid="filter-status"]');
  const gameCards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];

  if (categoryFilter && publisherFilter && clearFilters && filterStatus) {
    const params = new URLSearchParams(window.location.search);

    function selectedCategories(): string[] {
      return [...categoryFilter.selectedOptions].map((option) => option.value);
    }

    function updateUrl(categories: string[], publisher: string): void {
      const nextParams = new URLSearchParams();
      if (categories.length > 0) nextParams.set('category', categories.join(','));
      if (publisher) nextParams.set('publisher', publisher);
      const query = nextParams.toString();
      window.history.replaceState({}, '', query ? `${window.location.pathname}?${query}` : window.location.pathname);
    }

    function applyFilters(updateQuery = true): void {
      const categories = selectedCategories();
      const publisher = publisherFilter.value;
      let visibleCount = 0;

      gameCards.forEach((card) => {
        const matchesCategory =
          categories.length === 0 || categories.includes(card.dataset.categoryId ?? '');
        const matchesPublisher = !publisher || card.dataset.publisherId === publisher;
        const visible = matchesCategory && matchesPublisher;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      if (updateQuery) updateUrl(categories, publisher);
      filterStatus.textContent =
        visibleCount === 0
          ? 'No games match the selected filters.'
          : `${visibleCount} game${visibleCount === 1 ? '' : 's'} shown.`;
    }

    const initialCategories = (params.get('category') ?? '').split(',').filter(Boolean);
    initialCategories.forEach((category) => {
      const option = [...categoryFilter.options].find((candidate) => candidate.value === category);
      if (option) option.selected = true;
    });
    const initialPublisher = params.get('publisher') ?? '';
    if ([...publisherFilter.options].some((option) => option.value === initialPublisher)) {
      publisherFilter.value = initialPublisher;
    }

    categoryFilter.addEventListener('change', () => applyFilters());
    publisherFilter.addEventListener('change', () => applyFilters());
    clearFilters.addEventListener('click', () => {
      categoryFilter.selectedIndex = -1;
      publisherFilter.value = '';
      applyFilters();
      categoryFilter.focus();
    });
    applyFilters(false);
  }
</script>
